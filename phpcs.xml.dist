<?xml version="1.0"?>
<ruleset name="ViewMend TYPO3 Site Tracker">
    <description>PSR-12 coding standard for the ViewMend TYPO3 extension.</description>
    <file>Classes</file>
    <file>Configuration</file>
    <file>Tests</file>
    <file>ext_localconf.php</file>
    <rule ref="PSR12"/>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>
</ruleset>
